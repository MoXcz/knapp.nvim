{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "Lua 5.1",
    "path": ["lua/?.lua", "lua/?/init.lua", "tests/?.lua"]
  },
  "workspace": {
    "library": ["$VIMRUNTIME/lua", "${3rd}/luv/library"],
    "checkThirdParty": false,
    "ignoreDir": [".luarocks"]
  },
  "diagnostics": {
    "globals": ["vim", "describe", "it", "before_each", "after_each", "assert", "finally", "pending"]
  }
}
